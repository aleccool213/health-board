---
interface Props {
  label: string;
  value: string | number;
  unit?: string;
  tip: string;
}
const { label, value, unit, tip } = Astro.props;
---
<div class="tile">
  <div class="k">
    <span>{label}</span>
    <button class="hint" type="button" aria-label={`${label} explained`} data-tip={tip}>?</button>
  </div>
  <div class="v">{value}</div>
  {unit && <div class="u">{unit}</div>}
</div>
