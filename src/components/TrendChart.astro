---
interface Point {
  label: string;
  value: number | null;
  tip: string;
}

interface Props {
  title: string;
  unit?: string;
  points: Point[];
  kind?: 'line' | 'area' | 'bar';
  format?: 'int' | 'k' | 'fixed1';
}

const { title, unit, points, kind = 'line', format = 'int' } = Astro.props;

const W = 640;
const H = 220;
const pad = { t: 16, r: 12, b: 28, l: 40 };
const innerW = W - pad.l - pad.r;
const innerH = H - pad.t - pad.b;

function fmt(n: number) {
  if (format === 'k') {
    if (n >= 1000) return `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}k`;
    return String(Math.round(n));
  }
  if (format === 'fixed1') return n.toFixed(1);
  return String(Math.round(n));
}

const nums = points.map((p) => p.value).filter((v): v is number => v != null);
const rawMin = nums.length ? Math.min(...nums) : 0;
const rawMax = nums.length ? Math.max(...nums) : 1;
const zeroBased = kind === 'bar';
const span0 = zeroBased ? rawMax : rawMax - rawMin;
const padAmt = span0 === 0 ? Math.max(1, Math.abs(rawMax) * 0.08 || 1) : span0 * 0.12;
const yMin = zeroBased ? 0 : rawMin - padAmt;
const yMax = rawMax + padAmt;
const ySpan = yMax - yMin || 1;

function xOf(i: number) {
  if (points.length <= 1) return pad.l + innerW / 2;
  return pad.l + (i / (points.length - 1)) * innerW;
}
function yOf(v: number) {
  return pad.t + innerH - ((v - yMin) / ySpan) * innerH;
}

const ticks = 4;
const yTicks = Array.from({ length: ticks + 1 }, (_, i) => {
  const v = yMin + (ySpan * i) / ticks;
  return { v, y: yOf(v), label: fmt(v) };
});

const maxXLabels = 8;
const xStep = Math.max(1, Math.ceil(points.length / maxXLabels));
const xLabels = points
  .map((p, i) => ({ i, label: p.label, x: xOf(i) }))
  .filter((_, i) => i % xStep === 0 || i === points.length - 1);

const plotted = points
  .map((p, i) => (p.value == null ? null : { i, x: xOf(i), y: yOf(p.value), p }))
  .filter((d): d is { i: number; x: number; y: number; p: Point } => d != null);

const line = plotted.map((d, n) => `${n === 0 ? 'M' : 'L'}${d.x.toFixed(1)} ${d.y.toFixed(1)}`).join(' ');
const area =
  plotted.length > 1
    ? `${line} L${plotted[plotted.length - 1].x.toFixed(1)} ${(pad.t + innerH).toFixed(1)} L${plotted[0].x.toFixed(1)} ${(pad.t + innerH).toFixed(1)} Z`
    : '';

const barW = points.length ? Math.min(28, (innerW / points.length) * 0.62) : 8;
const bars = points.flatMap((p, i) => {
  if (p.value == null || p.value < 1) return [];
  const slot = innerW / points.length;
  const x = points.length === 1 ? pad.l + innerW / 2 : pad.l + i * slot + (slot - barW) / 2;
  const y = yOf(p.value);
  return [{ x, y, h: Math.max(1, pad.t + innerH - y), tip: p.tip }];
});

const showArea = kind === 'area' && Boolean(area);
const showLine = (kind === 'line' || kind === 'area') && Boolean(line);
const showBars = kind === 'bar';
const showDots = kind === 'line' || kind === 'area';
---

<section class="chart-card">
  <header class="chart-head">
    <h2>{title}</h2>
    {unit && <p>{unit}</p>}
  </header>
  <svg class="chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title}>
    {yTicks.map((t) => (
      <g>
        <line class="grid" x1={pad.l} x2={W - pad.r} y1={t.y} y2={t.y} />
        <text class="tick" x={pad.l - 8} y={t.y + 3} text-anchor="end">{t.label}</text>
      </g>
    ))}
    {xLabels.map((t) => (
      <text class="tick" x={t.x} y={H - 8} text-anchor="middle">{t.label}</text>
    ))}

    {showArea && <path class="area" d={area} />}
    {showLine && <path class="line" d={line} />}

    {showBars &&
      bars.map((b) => (
        <rect
          class="bar plot-hit"
          x={b.x}
          y={b.y}
          width={barW}
          height={b.h}
          data-tip={b.tip}
          tabindex="0"
          role="img"
          aria-label={b.tip}
        />
      ))}

    {showDots &&
      plotted.map((d) => (
        <g>
          <circle class="pt" cx={d.x} cy={d.y} r="3.2" />
          <circle
            class="plot-hit"
            cx={d.x}
            cy={d.y}
            r="11"
            fill="transparent"
            data-tip={d.p.tip}
            tabindex="0"
            role="img"
            aria-label={d.p.tip}
          />
        </g>
      ))}
  </svg>
</section>

<style>
  .chart-card {
    background: var(--card);
    border: 1px solid var(--line);
    padding: 0.85rem 0.75rem 0.5rem;
    margin-top: 0.75rem;
  }
  .chart-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0 0.35rem 0.35rem;
  }
  .chart-head h2 {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .chart-head p {
    margin: 0;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .chart { width: 100%; height: auto; display: block; overflow: visible; }
  .grid { stroke: var(--line); stroke-dasharray: 3 6; stroke-width: 1; }
  .tick { fill: var(--muted); font-size: 11px; font-family: inherit; }
  .line { fill: none; stroke: var(--accent); stroke-width: 2; }
  .area { fill: var(--accent); fill-opacity: 0.12; stroke: none; }
  .pt { fill: var(--accent); stroke: var(--card); stroke-width: 1; }
  .bar { fill: var(--accent); }
  .plot-hit { cursor: pointer; }
  .plot-hit:focus-visible { outline: 1px solid var(--accent); outline-offset: 1px; }
</style>
