---
import raw from '../data/workouts.json';

type Day = { date: string; workouts: number; types: string[] };
const days = raw as Day[];

const labels: Record<string, string> = {
  'strength-training': 'Strength',
  rowing: 'Row',
  yoga: 'Yoga',
  walking: 'Walk',
  running: 'Run',
};

function pretty(types: string[]) {
  return types.map((t) => labels[t] || t).join(', ');
}

function level(n: number) {
  if (n <= 0) return 0;
  if (n === 1) return 1;
  if (n === 2) return 2;
  return 3;
}

const byDate = new Map(days.map((d) => [d.date, d]));
const start = new Date(days[0].date + 'T00:00:00');
const end = new Date(days[days.length - 1].date + 'T00:00:00');

const startMon = new Date(start);
startMon.setDate(start.getDate() - ((start.getDay() + 6) % 7));
const endSun = new Date(end);
endSun.setDate(end.getDate() + ((7 - end.getDay()) % 7));

const weeks: Day[][] = [];
let col: Day[] = [];
for (let t = startMon.getTime(); t <= endSun.getTime(); t += 86400000) {
  const dt = new Date(t);
  const iso = dt.toISOString().slice(0, 10);
  col.push(byDate.get(iso) ?? { date: iso, workouts: 0, types: [] });
  if (col.length === 7) {
    weeks.push(col);
    col = [];
  }
}

const months: { label: string; index: number }[] = [];
let last = '';
weeks.forEach((week, i) => {
  const cell = week[0];
  const label = new Date(cell.date + 'T00:00:00').toLocaleString('en-CA', { month: 'short' });
  if (label !== last) {
    months.push({ label, index: i });
    last = label;
  }
});

const total = days.reduce((s, d) => s + d.workouts, 0);
const active = days.filter((d) => d.workouts > 0).length;
const sessions = days
  .filter((d) => d.workouts > 0)
  .slice()
  .reverse()
  .flatMap((d) => (d.types.length ? d.types : ['workout']).map((type) => ({ date: d.date, type })));

function niceDate(iso: string) {
  return new Date(iso + 'T00:00:00').toLocaleDateString('en-CA', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
  });
}
---
<section class="workouts">
  <div class="workouts-head">
    <h2>Workouts</h2>
    <p>{total} sessions across {active} days</p>
  </div>
  <div class="graph-wrap" style={`--weeks: ${weeks.length}`}>
    <div class="dow">
      <span></span>
      <span>Mon</span>
      <span></span>
      <span>Wed</span>
      <span></span>
      <span>Fri</span>
      <span></span>
    </div>
    <div class="graph-panel">
      <div class="months">
        {weeks.map((_, i) => {
          const m = months.find((x) => x.index === i);
          return <span>{m ? m.label : ''}</span>;
        })}
      </div>
      <div class="graph">
        {weeks.map((week) =>
          week.map((d) => {
            const n = d.workouts;
            const tip = n
              ? `${d.date} · ${n} workout${n === 1 ? '' : 's'}${d.types.length ? ' · ' + pretty(d.types) : ''}`
              : `${d.date} · rest`;
            return (
              <button
                class={`dot hint l${level(n)}`}
                type="button"
                data-tip={tip}
                aria-label={tip}
              />
            );
          })
        )}
      </div>
    </div>
  </div>
  <p class="graph-caption">Tap a square for the date.</p>
  <div class="legend">
    <span>Less</span>
    <i class="dot l0"></i>
    <i class="dot l1"></i>
    <i class="dot l2"></i>
    <i class="dot l3"></i>
    <span>More</span>
  </div>

  <ol class="session-list">
    {sessions.map((s) => (
      <li>
        <span class={`kind ${s.type}`} aria-hidden="true">
          {s.type === 'rowing' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 16h14M5 16l3-6 4 2 3-5"/><path d="M17 16l4 3"/></svg>
          )}
          {s.type === 'strength-training' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 9v6M17 9v6M4 10v4h3V10H4zm13 0v4h3v-4h-3zM7 12h10"/></svg>
          )}
          {s.type === 'yoga' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="5" r="2"/><path d="M12 7v5M8 21l4-9 4 9M6 12h12"/></svg>
          )}
          {s.type === 'walking' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="13" cy="5" r="2"/><path d="M8 21l3-7 3 2 3 5M11 14l-2-4 5-2 2 3"/></svg>
          )}
          {s.type === 'running' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="14" cy="5" r="2"/><path d="M6 21l4-8 3 2 4 6M10 13l2-4 4 1"/></svg>
          )}
          {!['rowing','strength-training','yoga','walking','running'].includes(s.type) && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/></svg>
          )}
        </span>
        <strong>{labels[s.type] || s.type}</strong>
        <time datetime={s.date}>{niceDate(s.date)}</time>
      </li>
    ))}
  </ol>
</section>

<style>
  .session-list { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .session-list li {
    display: grid;
    grid-template-columns: 1.7rem 1fr auto;
    gap: 0.7rem;
    align-items: center;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.55rem 0.8rem;
  }
  .session-list strong { font-weight: 500; font-size: 0.95rem; }
  .session-list time { color: var(--muted); font-size: 0.8rem; }
  .kind {
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 8px;
    display: grid;
    place-items: center;
    color: var(--accent);
    background: #1d2a23;
  }
  .kind svg { width: 1rem; height: 1rem; display: block; }
</style>
