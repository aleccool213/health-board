---
import raw from '../data/workouts.json';

type Day = { date: string; workouts: number; types: string[] };
const days = raw as Day[];

const labels: Record<string, string> = {
  'strength-training': 'Strength',
  rowing: 'Row',
  yoga: 'Yoga',
  walking: 'Walk',
  running: 'Run',
};

function pretty(types: string[]) {
  return types.map((t) => labels[t] || t).join(', ');
}

function level(n: number) {
  if (n <= 0) return 0;
  if (n === 1) return 1;
  if (n === 2) return 2;
  return 3;
}

const byDate = new Map(days.map((d) => [d.date, d]));
const start = new Date(days[0].date + 'T00:00:00');
const end = new Date(days[days.length - 1].date + 'T00:00:00');

const startMon = new Date(start);
startMon.setDate(start.getDate() - ((start.getDay() + 6) % 7));
const endSun = new Date(end);
endSun.setDate(end.getDate() + ((7 - end.getDay()) % 7));

const weeks: Day[][] = [];
let col: Day[] = [];
for (let t = startMon.getTime(); t <= endSun.getTime(); t += 86400000) {
  const dt = new Date(t);
  const iso = dt.toISOString().slice(0, 10);
  col.push(byDate.get(iso) ?? { date: iso, workouts: 0, types: [] });
  if (col.length === 7) {
    weeks.push(col);
    col = [];
  }
}

const months: { label: string; index: number }[] = [];
let last = '';
weeks.forEach((week, i) => {
  const cell = week[0];
  const label = new Date(cell.date + 'T00:00:00').toLocaleString('en-CA', { month: 'short' });
  if (label !== last) {
    months.push({ label, index: i });
    last = label;
  }
});

const total = days.reduce((s, d) => s + d.workouts, 0);
const active = days.filter((d) => d.workouts > 0).length;
const sessions = days
  .filter((d) => d.workouts > 0)
  .slice()
  .reverse()
  .flatMap((d) => (d.types.length ? d.types : ['workout']).map((type) => ({ date: d.date, type })));

const blurbs: Record<string, string> = {
  'strength-training': 'A saved strength session from Apple Watch — weights, bands, or bodyweight. Duration and heart-rate samples stay on the phone.',
  rowing: 'An indoor row logged on Apple Watch. Usually the Concept2 at home. Pace and split stay in the Health.md note, not on this public page.',
  yoga: 'A yoga or mobility session started as a Watch workout.',
  walking: 'A walk that was started as a workout, not just steps in the background.',
  running: 'A run started as a Watch workout.',
};

function niceDate(iso: string) {
  return new Date(iso + 'T00:00:00').toLocaleDateString('en-CA', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
  });
}
---
<section class="workouts">
  <div class="workouts-head">
    <h2>Workouts</h2>
    <p>{total} sessions across {active} days</p>
  </div>
  <div class="graph-wrap" style={`--weeks: ${weeks.length}`}>
    <div class="dow">
      <span></span>
      <span>Mon</span>
      <span></span>
      <span>Wed</span>
      <span></span>
      <span>Fri</span>
      <span></span>
    </div>
    <div class="graph-panel">
      <div class="months">
        {weeks.map((_, i) => {
          const m = months.find((x) => x.index === i);
          return <span>{m ? m.label : ''}</span>;
        })}
      </div>
      <div class="graph">
        {weeks.map((week) =>
          week.map((d) => {
            const n = d.workouts;
            const tip = n
              ? `${d.date} · ${n} workout${n === 1 ? '' : 's'}${d.types.length ? ' · ' + pretty(d.types) : ''}`
              : `${d.date} · rest`;
            return (
              <button
                class={`dot hint l${level(n)}`}
                type="button"
                data-tip={tip}
                aria-label={tip}
              />
            );
          })
        )}
      </div>
    </div>
  </div>
  <p class="graph-caption">Tap a square for the date.</p>
  <div class="legend">
    <span>Less</span>
    <i class="dot l0"></i>
    <i class="dot l1"></i>
    <i class="dot l2"></i>
    <i class="dot l3"></i>
    <span>More</span>
  </div>

  <ol class="session-list" id="session-list" data-page-size="5">
    {sessions.map((s) => (
      <li>
        <button
          type="button"
          class="session"
          data-type={labels[s.type] || s.type}
          data-date={niceDate(s.date)}
          data-iso={s.date}
          data-blurb={blurbs[s.type] || 'A workout saved on Apple Watch that week.'}
        >
          <span class={`kind ${s.type}`} aria-hidden="true">
            {s.type === 'rowing' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 16h14M5 16l3-6 4 2 3-5"/><path d="M17 16l4 3"/></svg>
            )}
            {s.type === 'strength-training' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 9v6M17 9v6M4 10v4h3V10H4zm13 0v4h3v-4h-3zM7 12h10"/></svg>
            )}
            {s.type === 'yoga' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="5" r="2"/><path d="M12 7v5M8 21l4-9 4 9M6 12h12"/></svg>
            )}
            {s.type === 'walking' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="13" cy="5" r="2"/><path d="M8 21l3-7 3 2 3 5M11 14l-2-4 5-2 2 3"/></svg>
            )}
            {s.type === 'running' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="14" cy="5" r="2"/><path d="M6 21l4-8 3 2 4 6M10 13l2-4 4 1"/></svg>
            )}
            {!['rowing','strength-training','yoga','walking','running'].includes(s.type) && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/></svg>
            )}
          </span>
          <strong>{labels[s.type] || s.type}</strong>
          <time datetime={s.date}>{niceDate(s.date)}</time>
        </button>
      </li>
    ))}
  </ol>
  <div class="pager" id="session-pager" hidden>
    <button type="button" data-dir="-1">Newer</button>
    <span data-status></span>
    <button type="button" data-dir="1">Older</button>
  </div>

  <dialog class="sheet" id="workout-sheet">
    <form method="dialog">
      <p class="sheet-k" data-date></p>
      <h3 data-type></h3>
      <p class="sheet-body" data-blurb></p>
      <p class="sheet-note">Public page only shows type and day. Heart rate, maps, and calories stay in Health.md.</p>
      <button value="close">Close</button>
    </form>
  </dialog>
</section>

<script>
  function paginate(listId: string, pagerId: string) {
    const list = document.getElementById(listId);
    const pager = document.getElementById(pagerId);
    if (!list || !pager) return;
    const rows = [...list.children] as HTMLElement[];
    const size = Number(list.dataset.pageSize) || 5;
    const pages = Math.max(1, Math.ceil(rows.length / size));
    let page = 0;
    const status = pager.querySelector("[data-status]");
    const buttons = pager.querySelectorAll("button");
    function render() {
      rows.forEach((row, i) => {
        row.toggleAttribute("hidden", i < page * size || i >= (page + 1) * size);
      });
      if (status) status.textContent = `${page + 1} / ${pages}`;
      buttons[0]?.toggleAttribute("disabled", page === 0);
      buttons[1]?.toggleAttribute("disabled", page >= pages - 1);
      pager.hidden = pages <= 1;
    }
    pager.addEventListener("click", (event) => {
      const btn = event.target instanceof HTMLElement ? event.target.closest("button") : null;
      if (!btn || btn.disabled) return;
      page = Math.min(pages - 1, Math.max(0, page + Number(btn.dataset.dir)));
      render();
    });
    render();
  }
  paginate("session-list", "session-pager");

  const sheet = document.getElementById("workout-sheet") as HTMLDialogElement | null;
  document.getElementById("session-list")?.addEventListener("click", (event) => {
    const btn = event.target instanceof HTMLElement ? event.target.closest(".session") : null;
    if (!btn || !sheet) return;
    const date = sheet.querySelector("[data-date]");
    const type = sheet.querySelector("[data-type]");
    const blurb = sheet.querySelector("[data-blurb]");
    if (date) date.textContent = btn.getAttribute("data-date") || "";
    if (type) type.textContent = btn.getAttribute("data-type") || "";
    if (blurb) blurb.textContent = btn.getAttribute("data-blurb") || "";
    sheet.showModal();
  });
</script>

<style>
  .session-list { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .session-list li {
    display: grid;
    grid-template-columns: 1.7rem 1fr auto;
    gap: 0.7rem;
    align-items: center;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.55rem 0.8rem;
  }
  .session-list strong { font-weight: 500; font-size: 0.95rem; }
  .session-list time { color: var(--muted); font-size: 0.8rem; }
  .kind {
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 8px;
    display: grid;
    place-items: center;
    color: var(--accent);
    background: #1d2a23;
  }
  .kind svg { width: 1rem; height: 1rem; display: block; }
  .session {
    width: 100%;
    display: grid;
    grid-template-columns: 1.7rem 1fr auto;
    gap: 0.7rem;
    align-items: center;
    background: transparent;
    border: 0;
    color: inherit;
    font: inherit;
    text-align: left;
    padding: 0;
    cursor: pointer;
  }
  .pager { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-top: 0.85rem; color: var(--muted); font-size: 0.85rem; }
  .pager button, .sheet button {
    background: var(--card);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.45rem 0.75rem;
    font: inherit;
    cursor: pointer;
  }
  .pager button:disabled { opacity: 0.4; cursor: default; }
  .sheet {
    width: min(26rem, calc(100vw - 1.5rem));
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #121916;
    color: var(--ink);
    padding: 1.1rem 1.15rem;
  }
  .sheet::backdrop { background: rgba(0,0,0,.55); }
  .sheet-k { margin: 0; color: var(--muted); font-size: 0.8rem; }
  .sheet h3 { margin: 0.25rem 0 0.7rem; font-size: 1.2rem; }
  .sheet-body { margin: 0 0 0.7rem; line-height: 1.45; }
  .sheet-note { margin: 0 0 1rem; color: var(--muted); font-size: 0.8rem; line-height: 1.4; }
</style>
