---
import { VAPID_PUBLIC_KEY } from "../lib/push-vapid";
---
<aside class="remind" id="remind-bar">
  <div class="remind-copy">
    <strong>Weekly import</strong>
    <span id="remind-status">Same path as Split Log: allow, subscribe, Sunday cron from Vercel.</span>
  </div>
  <dl class="remind-meta" id="remind-meta">
    <div><dt>This device</dt><dd id="remind-device">…</dd></div>
    <div><dt>Permission</dt><dd id="remind-perm">…</dd></div>
    <div><dt>Redis</dt><dd id="remind-kv">…</dd></div>
    <div><dt>VAPID</dt><dd id="remind-vapid">…</dd></div>
  </dl>
  <p class="remind-hint" id="remind-hint"></p>
  <p class="remind-error" id="remind-error" hidden></p>
  <div class="remind-actions">
    <button type="button" id="remind-enable">Allow + subscribe</button>
    <button type="button" id="remind-local">Local test</button>
    <button type="button" id="remind-server">Send server test</button>
  </div>
</aside>

<script define:vars={{ vapidPublic: VAPID_PUBLIC_KEY }}>
  const PUBLIC_KEY = vapidPublic;

  function isIosDevice() {
    return /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
  }
  function isStandalonePwa() {
    return (
      window.matchMedia("(display-mode: standalone)").matches ||
      window.matchMedia("(display-mode: fullscreen)").matches ||
      window.navigator.standalone === true
    );
  }
  function hasNotificationApi() {
    return typeof Notification !== "undefined";
  }
  function pushEnvironment() {
    const ios = isIosDevice();
    const standalone = isStandalonePwa();
    const notify = hasNotificationApi();
    const sw = "serviceWorker" in navigator;
    if (ios && !standalone) {
      return { kind: "needs-install", label: "Safari tab", hint: "Open the Home Screen Health board icon. Safari tabs cannot allow notifications." };
    }
    if (notify && sw) {
      return { kind: "ready", label: standalone ? "Installed PWA" : "Browser", hint: "Allow notifications, then send a test banner." };
    }
    if (ios && standalone && !notify) {
      return { kind: "needs-install", label: "Home Screen app", hint: "Reopen the Home Screen icon (not Safari). Notification API is still hidden." };
    }
    return { kind: "unsupported", label: "Not available", hint: "This browser has no Notifications API." };
  }

  function urlBase64ToUint8Array(base64String) {
    const padding = "=".repeat((4 - (base64String.length % 4)) % 4);
    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
    const raw = atob(base64);
    const output = new Uint8Array(raw.length);
    for (let i = 0; i < raw.length; i += 1) output[i] = raw.charCodeAt(i);
    return output;
  }

  async function getRegistration() {
    if (!("serviceWorker" in navigator)) return null;
    await navigator.serviceWorker.register("/sw.js", { scope: "/" }).catch(() => undefined);
    try {
      return await navigator.serviceWorker.ready;
    } catch {
      return navigator.serviceWorker.getRegistration();
    }
  }

  async function ensurePermission() {
    const env = pushEnvironment();
    if (env.kind === "needs-install") throw new Error(env.hint);
    if (!hasNotificationApi()) throw new Error("Notifications are not available in this browser.");
    if (Notification.permission === "granted") return "granted";
    if (Notification.permission === "denied") {
      throw new Error("iOS blocked Health board. Settings → Notifications → Health tracker → Allow Notifications. Then force-quit the PWA and open the Home Screen icon again.");
    }
    const next = await Notification.requestPermission();
    if (next !== "granted") {
      throw new Error(
        next === "denied"
          ? "You tapped Don’t Allow. iOS will not ask again until you enable it in Settings → Notifications → Health tracker."
          : "Permission was dismissed. Tap Allow + subscribe again and choose Allow on the iOS sheet.",
      );
    }
    return next;
  }

  async function subscribePush() {
    await ensurePermission();
    const reg = await getRegistration();
    if (!reg?.pushManager) throw new Error("Push manager missing. Reopen the Home Screen app.");
    let sub = await reg.pushManager.getSubscription();
    if (!sub) {
      sub = await reg.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: urlBase64ToUint8Array(PUBLIC_KEY),
      });
    }
    const json = sub.toJSON();
    if (!json.endpoint || !json.keys?.p256dh || !json.keys?.auth) throw new Error("Push subscription was incomplete.");
    return { endpoint: json.endpoint, keys: { p256dh: json.keys.p256dh, auth: json.keys.auth } };
  }

  const statusEl = document.getElementById("remind-status");
  const hintEl = document.getElementById("remind-hint");
  const errorEl = document.getElementById("remind-error");
  const deviceEl = document.getElementById("remind-device");
  const permEl = document.getElementById("remind-perm");
  const kvEl = document.getElementById("remind-kv");
  const vapidEl = document.getElementById("remind-vapid");

  function showError(msg) {
    if (!errorEl) return;
    errorEl.hidden = !msg;
    errorEl.textContent = msg || "";
  }

  function renderEnv() {
    const env = pushEnvironment();
    if (deviceEl) deviceEl.textContent = env.label;
    if (permEl) permEl.textContent = hasNotificationApi() ? Notification.permission : "hidden until installed";
    if (hintEl) hintEl.textContent = env.hint;
    if (statusEl) {
      statusEl.textContent =
        env.kind === "ready"
          ? "Sunday 9:00 America/Toronto via Vercel cron (same closed-phone path as Split Log)."
          : env.hint;
    }
  }

  async function refreshStatus() {
    renderEnv();
    try {
      const res = await fetch("/api/push/status");
      const s = await res.json();
      if (kvEl) kvEl.textContent = s.kvReady ? "Connected" : "Not connected";
      if (vapidEl) vapidEl.textContent = s.vapidReady ? "Ready" : "Private key missing";
    } catch {
      if (kvEl) kvEl.textContent = "unreachable";
      if (vapidEl) vapidEl.textContent = "unreachable";
    }
  }

  async function onEnable() {
    showError("");
    try {
      await ensurePermission();
      const sub = await subscribePush();
      const saved = await fetch("/api/push/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ data: sub }),
      }).then((r) => r.json());
      if (saved && saved.ok === false) throw new Error(saved.error);
      if (statusEl) statusEl.textContent = "This iPhone is subscribed for closed-app reminders";
      renderEnv();
    } catch (err) {
      showError(err instanceof Error ? err.message : String(err));
    }
  }

  async function onLocalTest() {
    showError("");
    try {
      await ensurePermission();
      const reg = await getRegistration();
      if (!reg) throw new Error("Service worker did not register. Reopen the Home Screen app and try again.");
      await reg.showNotification("Health board — local test", {
        body: "Local banner from the open app. Use Send server test to hit the locked-phone path.",
        icon: "/favicon.svg",
        badge: "/favicon.svg",
        tag: "health-board-debug",
        data: { url: "/?import=1" },
      });
    } catch (err) {
      showError(err instanceof Error ? err.message : String(err));
    }
  }

  async function onServerTest() {
    showError("");
    try {
      const sub = await subscribePush();
      const result = await fetch("/api/push/test", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ data: sub }),
      }).then((r) => r.json());
      if (!result.ok) throw new Error(result.error);
      if (statusEl) {
        statusEl.textContent =
          result.result === "gone"
            ? "Subscription expired — tap Allow again"
            : "Server push sent — lock the phone and wait a second";
      }
    } catch (err) {
      showError(err instanceof Error ? err.message : String(err));
    }
  }

  document.getElementById("remind-enable")?.addEventListener("click", onEnable);
  document.getElementById("remind-local")?.addEventListener("click", onLocalTest);
  document.getElementById("remind-server")?.addEventListener("click", onServerTest);
  refreshStatus();
</script>

<style>
  .remind {
    margin-top: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background: var(--card);
    border: 1px solid var(--line);
    padding: 0.7rem 0.85rem;
  }
  .remind-copy {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .remind-copy strong {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .remind-copy span,
  .remind-hint {
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.35;
    margin: 0;
  }
  .remind-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem 0.75rem;
    margin: 0;
    font-size: 0.75rem;
  }
  .remind-meta dt { color: var(--muted); }
  .remind-meta dd { margin: 0.1rem 0 0; font-weight: 600; }
  .remind-error {
    margin: 0;
    color: var(--warn);
    font-size: 0.78rem;
  }
  .remind-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .remind-actions button {
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink);
    font: 600 0.72rem/1 "JetBrains Mono", ui-monospace, monospace;
    padding: 0.45rem 0.6rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .remind-actions button:hover { border-color: var(--ink); }
  #remind-enable { border-color: var(--accent); color: var(--accent); }
</style>
