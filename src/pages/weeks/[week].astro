---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import OmStat from '@omarchy/ui/astro/OmStat.astro';
import OmStatGrid from '@omarchy/ui/astro/OmStatGrid.astro';

export async function getStaticPaths() {
  const weeks = await getCollection('weeks');
  return weeks.map((entry) => ({
    params: { week: entry.data.week },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={`${d.week} · Alec Brunelle’s health tracker`}>
  <p><a href="/">← Tracker</a></p>
  <h1>{d.week}</h1>
  <p class="sub">
    {d.start.toISOString().slice(0, 10)} – {d.end.toISOString().slice(0, 10)}
    {d.partial && ' · partial week'}
  </p>
  <OmStatGrid>
    <OmStat label="Steps / day" value={d.steps_avg} format="locale" hint="Average steps walked each day that week. A rough picture of how much he moved around." />
    <OmStat label="Sleep" value={d.sleep_hours_avg} format="fixed2" unit="hours avg" unitPlacement="block" hint="Average time actually asleep on nights that logged. Nights with no Watch sample are skipped." />
    <OmStat label="Resting HR" value={d.resting_hr_avg} unit="bpm" unitPlacement="block" hint="How fast the heart beats when sitting still. Lower is generally fitter; illness and poor sleep can raise it." />
    <OmStat label="HRV" value={d.hrv_avg} unit="ms" unitPlacement="block" hint="Heart rate variability — the tiny gaps between beats. Higher often means more recovered." />
    <OmStat label="Exercise min" value={d.exercise_min_total} hint="Apple Exercise minutes for the whole week. Time the Watch counted as elevated activity." />
    <OmStat label="Workouts" value={d.workouts} hint="Saved workout sessions that week. A walk only counts if it was started as a workout." />
    <OmStat label="Active kcal" value={d.active_kcal_total} format="locale" hint="Calories Apple estimates from movement on top of resting burn, summed for the week." />
    <OmStat label="Days logged" value={d.days} hint="How many days in this Monday–Sunday week had a Health.md note." />
  </OmStatGrid>
  <article style="margin-top:1.25rem;">
    <Content />
  </article>
</Base>
