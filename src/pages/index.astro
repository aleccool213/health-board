---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import OmStat from '@omarchy/ui/astro/OmStat.astro';
import OmStatGrid from '@omarchy/ui/astro/OmStatGrid.astro';
import WorkoutGraph from '../components/WorkoutGraph.astro';
import TrendChart from '../components/TrendChart.astro';
import rawWorkouts from '../data/workouts.json';

type Day = { date: string; workouts: number; types: string[] };

const weeks = (await getCollection('weeks')).sort(
  (a, b) => b.data.start.getTime() - a.data.start.getTime()
);
const latest = weeks[0];
const chrono = [...weeks].reverse();

function md(iso: Date) {
  return `${iso.getUTCMonth() + 1}/${iso.getUTCDate()}`;
}

const steps = chrono.map((w) => ({
  label: md(w.data.start),
  value: w.data.steps_avg,
  tip: `${w.data.week} · ${w.data.steps_avg.toLocaleString()} steps/day`,
}));
const sleep = chrono.map((w) => ({
  label: md(w.data.start),
  value: w.data.sleep_hours_avg,
  tip:
    w.data.sleep_hours_avg == null
      ? `${w.data.week} · no sleep nights logged`
      : `${w.data.week} · ${w.data.sleep_hours_avg.toFixed(2)} h avg`,
}));
const rhr = chrono.map((w) => ({
  label: md(w.data.start),
  value: w.data.resting_hr_avg,
  tip: `${w.data.week} · ${w.data.resting_hr_avg} bpm resting`,
}));
const hrv = chrono.map((w) => ({
  label: md(w.data.start),
  value: w.data.hrv_avg,
  tip: `${w.data.week} · ${w.data.hrv_avg} ms HRV`,
}));
const exercise = chrono.map((w) => ({
  label: md(w.data.start),
  value: w.data.exercise_min_total,
  tip: `${w.data.week} · ${w.data.exercise_min_total} exercise min · ${w.data.workouts} workouts`,
}));

const labels: Record<string, string> = {
  'strength-training': 'Strength',
  rowing: 'Row',
  yoga: 'Yoga',
  walking: 'Walk',
  running: 'Run',
};
const days = rawWorkouts as Day[];
const daily = days.slice(-56).map((d) => {
  const pretty = d.types.map((t) => labels[t] || t).join(', ');
  return {
    label: `${Number(d.date.slice(5, 7))}/${Number(d.date.slice(8, 10))}`,
    value: d.workouts,
    tip: d.workouts
      ? `${d.date} · ${d.workouts} workout${d.workouts === 1 ? '' : 's'}${pretty ? ' · ' + pretty : ''}`
      : `${d.date} · rest`,
  };
});
---
<Base title="Alec Brunelle’s health tracker">
  {latest && (
    <>
      <h1>{latest.data.week}{latest.data.partial && ' · in progress'}</h1>
      <p class="sub">
        {latest.data.start.toISOString().slice(0, 10)}
        – {latest.data.end.toISOString().slice(0, 10)}
        · {latest.data.days} days logged
      </p>
      <OmStatGrid>
        <OmStat label="Steps / day" value={latest.data.steps_avg} format="locale" hint="Average steps walked each day that week. A rough picture of how much he moved around." />
        <OmStat label="Sleep" value={latest.data.sleep_hours_avg} format="fixed2" unit="hours avg" hint="Average time actually asleep on nights that logged. Nights with no Watch sample are skipped, so this is not bedtime." />
        <OmStat label="Resting HR" value={latest.data.resting_hr_avg} unit="bpm" hint="Resting heart rate: how fast the heart beats when sitting still. Lower is generally fitter, though illness and poor sleep can bump it up." />
        <OmStat label="HRV" value={latest.data.hrv_avg} unit="ms" hint="Heart rate variability — the tiny gaps between beats. Higher often means more recovered; a dip can mean stress, sickness, or a hard training week." />
        <OmStat label="Exercise" value={latest.data.exercise_min_total} unit="min" hint="Apple Exercise minutes for the whole week. Time the Watch counted as elevated activity, not gym-only." />
        <OmStat label="Workouts" value={latest.data.workouts} hint="Number of saved workout sessions that week (row, walk, strength, and so on). A walk only counts if it was started as a workout." />
      </OmStatGrid>
    </>
  )}

  <WorkoutGraph />

  <h2 class="section-label">Trends</h2>
  <p class="chart-note">Weekly averages published here. Daily Health.md notes stay private. Tap a point for the week.</p>
  <TrendChart title="Steps / day" unit="weekly avg" kind="area" format="k" points={steps} />
  <TrendChart title="Sleep" unit="hours avg" kind="line" format="fixed1" points={sleep} />
  <TrendChart title="Resting HR" unit="bpm" kind="line" format="int" points={rhr} />
  <TrendChart title="HRV" unit="ms" kind="line" format="int" points={hrv} />
  <TrendChart title="Exercise minutes" unit="sum for the week" kind="bar" format="int" points={exercise} />
  <TrendChart title="Workouts by day" unit="last 8 weeks" kind="bar" format="int" points={daily} />

  <h2 class="section-label" id="weeks">Weeks</h2>
  <div class="list">
    {weeks.slice(0, 5).map((w) => (
      <a class="row" href={`/weeks/${w.data.week}`}>
        <strong>{w.data.week}</strong>
        <span style="color:var(--muted)">{w.data.steps_avg.toLocaleString()} steps/day · {w.data.workouts} workouts</span>
        {w.data.partial ? <span class="badge">partial</span> : <span></span>}
      </a>
    ))}
  </div>
</Base>
