---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Stat from '../components/Stat.astro';
import WorkoutGraph from '../components/WorkoutGraph.astro';

const weeks = (await getCollection('weeks')).sort(
  (a, b) => b.data.start.getTime() - a.data.start.getTime()
);
const latest = weeks[0];

function spark(values: number[]) {
  if (!values.length) return '';
  const min = Math.min(...values);
  const max = Math.max(...values);
  const span = max - min || 1;
  const w = 120;
  const h = 36;
  const pts = values.map((v, i) => {
    const x = values.length === 1 ? w / 2 : (i / (values.length - 1)) * w;
    const y = h - 4 - ((v - min) / span) * (h - 8);
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  });
  return pts.join(' ');
}

const chrono = [...weeks].reverse();
const stepSpark = spark(chrono.map((w) => w.data.steps_avg));
const sleepSpark = spark(chrono.filter((w) => w.data.sleep_hours_avg != null).map((w) => w.data.sleep_hours_avg as number));
const rhrSpark = spark(chrono.map((w) => w.data.resting_hr_avg));
---
<Base title="Health board">
  {latest && (
    <>
      <h1>{latest.data.week}{latest.data.partial && ' · in progress'}</h1>
      <p class="sub">
        {latest.data.start.toISOString().slice(0, 10)}
        – {latest.data.end.toISOString().slice(0, 10)}
        · {latest.data.days} days logged
      </p>
      <div class="grid">
        <Stat label="Steps / day" value={latest.data.steps_avg.toLocaleString()} tip="Average steps walked each day that week. A rough picture of how much he moved around." />
        <Stat label="Sleep" value={latest.data.sleep_hours_avg ?? '—'} unit="hours avg" tip="Average time actually asleep on nights that logged. Nights with no Watch sample are skipped, so this is not bedtime." />
        <Stat label="Resting HR" value={latest.data.resting_hr_avg} unit="bpm" tip="Resting heart rate: how fast the heart beats when sitting still. Lower is generally fitter, though illness and poor sleep can bump it up." />
        <Stat label="HRV" value={latest.data.hrv_avg} unit="ms" tip="Heart rate variability — the tiny gaps between beats. Higher often means more recovered; a dip can mean stress, sickness, or a hard training week." />
        <Stat label="Exercise" value={latest.data.exercise_min_total} unit="min" tip="Apple Exercise minutes for the whole week. Time the Watch counted as elevated activity, not gym-only." />
        <Stat label="Workouts" value={latest.data.workouts} tip="Number of saved workout sessions that week (row, walk, strength, and so on). A walk only counts if it was started as a workout." />
      </div>
    </>
  )}

  <WorkoutGraph />

  <h2 style="margin-top:2rem;font-size:1rem;color:var(--muted);font-weight:500;">Trend</h2>
  <div class="grid" style="margin-top:0.6rem;">
    <div class="tile">
      <div class="k">Steps</div>
      <svg class="spark" viewBox="0 0 120 36" aria-hidden="true"><polyline fill="none" stroke="#7dcea0" stroke-width="2" points={stepSpark} /></svg>
    </div>
    <div class="tile">
      <div class="k">Sleep</div>
      <svg class="spark" viewBox="0 0 120 36" aria-hidden="true"><polyline fill="none" stroke="#7dcea0" stroke-width="2" points={sleepSpark} /></svg>
    </div>
    <div class="tile">
      <div class="k">Resting HR</div>
      <svg class="spark" viewBox="0 0 120 36" aria-hidden="true"><polyline fill="none" stroke="#7dcea0" stroke-width="2" points={rhrSpark} /></svg>
    </div>
  </div>

  <h2 style="margin-top:2rem;font-size:1rem;color:var(--muted);font-weight:500;">Weeks</h2>
  <div class="list" id="week-list" data-page-size="5">
    {weeks.map((w) => (
      <a class="row" href={`/weeks/${w.data.week}`}>
        <strong>{w.data.week}</strong>
        <span style="color:var(--muted)">{w.data.steps_avg.toLocaleString()} steps/day · {w.data.workouts} workouts</span>
        {w.data.partial ? <span class="badge">partial</span> : <span></span>}
      </a>
    ))}
  </div>
  <style>
    .pager { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-top: 0.85rem; color: var(--muted); font-size: 0.85rem; }
    .pager button { background: var(--card); color: var(--ink); border: 1px solid var(--line); border-radius: 8px; padding: 0.45rem 0.75rem; font: inherit; cursor: pointer; }
    .pager button:disabled { opacity: 0.4; cursor: default; }
    .pager button:not(:disabled):hover { border-color: var(--accent); }
  </style>
  <div class="pager" id="week-pager" hidden>
    <button type="button" data-dir="-1">Newer</button>
    <span data-status></span>
    <button type="button" data-dir="1">Older</button>
  </div>
  <script>
    const list = document.getElementById("week-list");
    const pager = document.getElementById("week-pager");
    if (list && pager) {
      const rows = [...list.querySelectorAll(".row")];
      const size = Number(list.dataset.pageSize) || 5;
      const pages = Math.max(1, Math.ceil(rows.length / size));
      let page = 0;
      const status = pager.querySelector("[data-status]");
      const buttons = pager.querySelectorAll("button");

      function render() {
        rows.forEach((row, i) => {
          row.toggleAttribute("hidden", i < page * size || i >= (page + 1) * size);
        });
        if (status) status.textContent = `${page + 1} / ${pages}`;
        buttons[0]?.toggleAttribute("disabled", page === 0);
        buttons[1]?.toggleAttribute("disabled", page >= pages - 1);
        pager.hidden = pages <= 1;
      }

      pager.addEventListener("click", (event) => {
        const btn = event.target instanceof HTMLElement ? event.target.closest("button") : null;
        if (!btn || btn.disabled) return;
        page = Math.min(pages - 1, Math.max(0, page + Number(btn.dataset.dir)));
        render();
      });

      render();
    }
  </script>
</Base>
