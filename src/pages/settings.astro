---
import Base from '../layouts/Base.astro';
import Reminder from '../components/Reminder.astro';
---
<Base title="Settings · Alec Brunelle’s health tracker">
  <p class="kicker">Settings</p>
  <h1>Source & reminders</h1>
  <p class="sub">
    The board is public. Weekly averages live in the repo — edit a week file, push, and Vercel shows it.
    Daily Health.md notes stay in Drive.
  </p>

  <div class="settings-stack">
    <section class="tile settings-card">
      <h2>PWA notifications</h2>
      <p class="chart-note">
        Device banners only — same closed-phone path as Split Log. Allow once from the Home Screen icon,
        then send a test to confirm this phone can show the Sunday import reminder.
      </p>
      <Reminder />
    </section>

    <section class="tile settings-card">
      <h2>Published source</h2>
      <p class="chart-note">
        Weekly rollups live in <code>src/content/weeks/</code>. Workouts heatmap is <code>src/data/workouts.json</code>.
        Raw dailies are not in this repo.
      </p>
      <p class="chart-note">
        ISO weeks are Monday–Sunday, America/Toronto. Sync from Grok with <code>sync health</code>.
      </p>
    </section>
  </div>
</Base>
