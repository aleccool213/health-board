---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Alec Brunelle's health tracker — weekly Apple Watch averages." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#dedede" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Health tracker" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("health-board-theme");
          var d = t === "dark" || (t !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", d);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="shell">
      <header class="top">
        <div class="brand">
          <a class="mark" href="/">
            <svg class="logo" viewBox="0 0 32 32" aria-hidden="true" shape-rendering="crispEdges">
              <rect width="32" height="32" fill="#4f6ef7" />
              <rect x="6" y="6" width="4" height="20" fill="#ffffff" />
              <rect x="10" y="6" width="8" height="4" fill="#ffffff" />
              <rect x="10" y="14" width="6" height="4" fill="#c5cffc" />
              <rect x="10" y="22" width="8" height="4" fill="#ffffff" />
            </svg>
            Health board
          </a>
          <button class="theme" type="button" id="theme-toggle" aria-label="Toggle theme">Aa</button>
        </div>
        <p class="lede">A public weekly snapshot from Apple Watch. Daily notes stay private.</p>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        Apple Watch writes daily notes through Health.md. Once a week those days are rolled into averages and published here — no GPS, meds, or raw dumps. Tap a ? for what each stat means.
      </footer>
    </div>
    <div id="float-tip" hidden></div>
    <script>
      const tip = document.getElementById("float-tip");

      function hideTip() {
        if (!tip) return;
        tip.hidden = true;
        tip.textContent = "";
        document.querySelectorAll(".hint.open").forEach((el) => el.classList.remove("open"));
      }

      function showTip(btn) {
        if (!tip) return;
        const text = btn.getAttribute("data-tip");
        if (!text) return;
        document.querySelectorAll(".hint.open").forEach((el) => el.classList.remove("open"));
        btn.classList.add("open");
        tip.hidden = false;
        tip.textContent = text;
        const pad = 10;
        const r = btn.getBoundingClientRect();
        const tw = tip.offsetWidth;
        const th = tip.offsetHeight;
        let left = r.left + r.width / 2 - tw / 2;
        left = Math.max(pad, Math.min(left, window.innerWidth - tw - pad));
        let top = r.bottom + 8;
        if (top + th > window.innerHeight - pad) top = r.top - th - 8;
        if (top < pad) top = pad;
        tip.style.left = `${left}px`;
        tip.style.top = `${top}px`;
      }

      document.addEventListener("click", (event) => {
        const t = event.target;
        if (!(t instanceof HTMLElement)) return;
        const btn = t.closest(".hint");
        if (btn instanceof HTMLElement) {
          if (btn.classList.contains("open")) hideTip();
          else showTip(btn);
          return;
        }
        hideTip();
      });

      window.addEventListener("scroll", hideTip, { passive: true });
      window.addEventListener("resize", hideTip);

      const toggle = document.getElementById("theme-toggle");
      toggle?.addEventListener("click", () => {
        const next = document.documentElement.classList.contains("dark") ? "light" : "dark";
        document.documentElement.classList.toggle("dark", next === "dark");
        try { localStorage.setItem("health-board-theme", next); } catch (e) {}
      });

      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafafa;
    --card: #ffffff;
    --ink: #000000;
    --muted: #555555;
    --line: #d4d4d4;
    --accent: #4f6ef7;
    --accent-ink: #ffffff;
    --warn: #8a5a00;
    --pixel: #c5cffc;
    --dot-0: #ececec;
    --dot-1: #c5cffc;
    --dot-2: #7b8cff;
    --dot-3: #4f6ef7;
    --kind: #eef1ff;
  }
  html.dark {
    --bg: #121212;
    --card: #1a1a1a;
    --ink: #f5f5f5;
    --muted: #a3a3a3;
    --line: #2e2e2e;
    --accent: #7b8cff;
    --accent-ink: #0a0a0a;
    --warn: #e0b07a;
    --pixel: #2a3358;
    --dot-0: #242424;
    --dot-1: #2a3358;
    --dot-2: #4f6ef7;
    --dot-3: #7b8cff;
    --kind: #1c2240;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: "JetBrains Mono", ui-monospace, "SF Mono", monospace;
    overflow-x: clip;
    max-width: 100%;
  }
  body {
    background-image: radial-gradient(var(--pixel) 1.35px, transparent 1.35px);
    background-size: 18px 18px;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .shell { max-width: 840px; margin: 0 auto; padding: max(2rem, env(safe-area-inset-top)) max(1rem, env(safe-area-inset-right)) max(3.5rem, env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left)); overflow-x: clip; }
  .top { margin-bottom: 1.5rem; }
  .brand { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink);
    font-size: 1.05rem;
  }
  .mark:hover { text-decoration: none; }
  .logo { width: 2rem; height: 2rem; display: block; }
  .theme {
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink);
    font: 600 0.75rem/1 "JetBrains Mono", ui-monospace, monospace;
    width: 2.25rem;
    height: 2.25rem;
    cursor: pointer;
  }
  .theme:hover { border-color: var(--ink); }
  .lede { color: var(--muted); margin: 0.55rem 0 0; line-height: 1.45; }
  footer { margin-top: 3rem; color: var(--muted); font-size: 0.85rem; line-height: 1.5; }
  h1 { font-size: 1.7rem; font-weight: 600; margin: 0 0 0.35rem; letter-spacing: -0.04em; }
  .sub { color: var(--muted); margin: 0 0 1.25rem; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.65rem; }
  @media (min-width: 640px) {
    .shell { padding: 2.5rem max(1.25rem, env(safe-area-inset-right)) 4rem max(1.25rem, env(safe-area-inset-left)); }
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    h1 { font-size: 2rem; }
  }
  .tile { background: var(--card); border: 1px solid var(--line); border-radius: 0; padding: 0.85rem 0.9rem; min-width: 0; }
  .tile .k { color: var(--muted); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; display: flex; align-items: center; gap: 0.35rem; }
  .tile .v { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 1.35rem; font-weight: 600; margin-top: 0.25rem; font-variant-numeric: tabular-nums; }
  .tile .u { color: var(--muted); font-size: 0.8rem; }
  .hint {
    flex: 0 0 auto;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 0;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    font: 600 0.7rem/1 "JetBrains Mono", ui-monospace, monospace;
    cursor: pointer;
    padding: 0;
  }
  .hint:hover, .hint:focus-visible, .hint.open { border-color: var(--accent); color: var(--accent); }
  #float-tip {
    position: fixed;
    z-index: 40;
    max-width: min(260px, calc(100vw - 20px));
    background: var(--ink);
    color: var(--card);
    border: 1px solid var(--ink);
    border-radius: 0;
    padding: 0.55rem 0.65rem;
    font-size: 0.8rem;
    line-height: 1.4;
    pointer-events: none;
  }
  .list { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 1.5rem; }
  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.2rem 0.75rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0;
    padding: 0.8rem 1rem;
    color: inherit;
  }
  @media (min-width: 640px) {
    .row { grid-template-columns: 7rem 1fr auto; align-items: center; }
  }
  .row:hover { border-color: var(--accent); text-decoration: none; }
  .badge { font-size: 0.7rem; color: var(--warn); border: 1px solid var(--warn); border-radius: 0; padding: 0.1rem 0.45rem; width: max-content; }
  article { background: var(--card); border: 1px solid var(--line); border-radius: 0; padding: 1.1rem 1.15rem; line-height: 1.55; }
  .spark { width: 100%; height: 36px; }
  .workouts { margin-top: 2rem; }
  .workouts-head { display: flex; flex-direction: column; gap: 0.2rem; margin-bottom: 0.85rem; }
  @media (min-width: 640px) {
    .workouts-head { flex-direction: row; align-items: baseline; justify-content: space-between; }
  }
  .workouts-head h2 { font-size: 1rem; color: var(--muted); font-weight: 500; margin: 0; }
  .workouts-head p { color: var(--muted); font-size: 0.85rem; margin: 0; }
  .graph-wrap {
    display: grid;
    grid-template-columns: 1.7rem minmax(0, 1fr);
    gap: 0.4rem;
    width: 100%;
    max-width: 100%;
  }
  .graph-panel { min-width: 0; }
  .dow {
    display: grid;
    grid-template-rows: 16px repeat(7, minmax(0, 1fr));
    gap: 3px;
    color: var(--muted);
    font-size: 0.62rem;
  }
  .dow span { display: flex; align-items: center; }
  .months {
    display: grid;
    grid-template-columns: repeat(var(--weeks, 13), minmax(0, 1fr));
    gap: 3px;
    color: var(--muted);
    font-size: 0.62rem;
    height: 16px;
    margin-bottom: 3px;
  }
  .months span { overflow: hidden; white-space: nowrap; }
  .graph {
    display: grid;
    grid-template-rows: repeat(7, minmax(0, 1fr));
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 3px;
    width: 100%;
  }
  .dot {
    width: 100%;
    aspect-ratio: 1;
    height: auto;
    border-radius: 0;
    border: 0;
    padding: 0;
    display: block;
    cursor: pointer;
    min-width: 0;
  }
  .dot.l0 { background: var(--dot-0); }
  .dot.l1 { background: var(--dot-1); }
  .dot.l2 { background: var(--dot-2); }
  .dot.l3 { background: var(--dot-3); }
  .legend { display: flex; align-items: center; gap: 0.3rem; margin-top: 0.7rem; color: var(--muted); font-size: 0.7rem; }
  .legend .dot { width: 11px; height: 11px; cursor: default; aspect-ratio: auto; }
  .graph-caption {
    margin: 0.65rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    min-height: 1.2em;
  }
</style>
