---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Weekly Apple Watch board. Averages only.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="shell">
      <header class="top">
        <a class="mark" href="/">Health board</a>
        <p class="lede">Weekly averages from Apple Watch. Raw days stay off this site.</p>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        Public rollup only — no GPS, meds, or daily dumps. Tap the ? beside a stat for a plain-English explainer.
      </footer>
    </div>
    <script>
      document.addEventListener("click", (event) => {
        const t = event.target;
        if (!(t instanceof HTMLElement)) return;
        const open = document.querySelector(".hint.open");
        if (open && open !== t) open.classList.remove("open");
        if (t.classList.contains("hint")) t.classList.toggle("open");
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0f1412;
    --card: #171e1b;
    --ink: #e8efe9;
    --muted: #8fa196;
    --line: #2a3530;
    --accent: #7dcea0;
    --warn: #e6c07b;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: var(--bg); color: var(--ink); font-family: "IBM Plex Sans", system-ui, sans-serif; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .shell { max-width: 840px; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
  .top { margin-bottom: 2rem; }
  .mark { font-weight: 600; letter-spacing: 0.02em; color: var(--ink); font-size: 1.05rem; }
  .lede { color: var(--muted); margin: 0.4rem 0 0; }
  footer { margin-top: 3rem; color: var(--muted); font-size: 0.85rem; }
  h1 { font-size: 1.6rem; font-weight: 600; margin: 0 0 0.35rem; }
  .sub { color: var(--muted); margin: 0 0 1.5rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.75rem; }
  .tile { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 0.9rem 1rem; }
  .tile .k { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; display: flex; align-items: center; gap: 0.35rem; }
  .tile .v { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 1.35rem; margin-top: 0.25rem; }
  .tile .u { color: var(--muted); font-size: 0.8rem; }
  .hint { position: relative; width: 1.05rem; height: 1.05rem; border-radius: 999px; border: 1px solid var(--line); background: transparent; color: var(--muted); font: 600 0.7rem/1 "IBM Plex Sans", system-ui, sans-serif; cursor: pointer; padding: 0; }
  .hint:hover, .hint:focus-visible, .hint.open { border-color: var(--accent); color: var(--accent); }
  .hint::after {
    content: attr(data-tip);
    position: absolute;
    left: 0;
    top: calc(100% + 8px);
    width: min(240px, 70vw);
    background: #0b100e;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.55rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.4;
    z-index: 5;
    box-shadow: 0 8px 24px rgba(0,0,0,.35);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px);
    transition: opacity .12s ease, transform .12s ease;
  }
  .hint:hover::after, .hint:focus-visible::after, .hint.open::after {
    opacity: 1;
    transform: none;
  }
  .list { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 1.5rem; }
  .row { display: grid; grid-template-columns: 7rem 1fr auto; gap: 0.75rem; align-items: center; background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 0.8rem 1rem; color: inherit; }
  .row:hover { border-color: var(--accent); text-decoration: none; }
  .badge { font-size: 0.7rem; color: var(--warn); border: 1px solid var(--warn); border-radius: 999px; padding: 0.1rem 0.45rem; }
  article { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 1.25rem 1.35rem; line-height: 1.55; }
  .spark { width: 100%; height: 36px; }
  .workouts { margin-top: 2rem; }
  .workouts-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 0.85rem; }
  .workouts-head h2 { font-size: 1rem; color: var(--muted); font-weight: 500; margin: 0; }
  .workouts-head p { color: var(--muted); font-size: 0.85rem; margin: 0; }
  .graph-wrap { display: flex; gap: 0.45rem; overflow-x: auto; padding-bottom: 0.4rem; }
  .dow { display: grid; grid-template-rows: 16px repeat(7, 12px); gap: 3px; color: var(--muted); font-size: 0.65rem; }
  .dow span { display: flex; align-items: center; }
  .months { display: grid; gap: 3px; color: var(--muted); font-size: 0.65rem; height: 16px; margin-bottom: 3px; }
  .graph { display: grid; grid-template-rows: repeat(7, 12px); grid-auto-flow: column; grid-auto-columns: 12px; gap: 3px; }
  .dot { width: 12px; height: 12px; border-radius: 3px; border: 0; padding: 0; display: block; cursor: pointer; position: relative; }
  .dot.l0 { background: #222c28; }
  .dot.l1 { background: #2f6f4a; }
  .dot.l2 { background: #4aa36c; }
  .dot.l3 { background: #7dcea0; }
  .legend { display: flex; align-items: center; gap: 0.3rem; margin-top: 0.7rem; color: var(--muted); font-size: 0.7rem; }
  .legend .dot { cursor: default; }
</style>
